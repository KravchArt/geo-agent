# =============================================================================
# Geo-Agent environment template.
# Copy to `.env` and fill values for local dev. NEVER commit a real `.env`.
# Values below are intentionally empty / dev-only placeholders.
# =============================================================================

# --- Runtime environment: dev | prod ---
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
UI_PORT=8501
# Browser-side public-IP discovery used only for approximate geolocation.
UI_PUBLIC_IP_LOOKUP_URL=https://api64.ipify.org?format=json

# --- PostgreSQL ---
# Inside docker compose the host is the service name `postgres`.
# Compose overrides this value for containers. Host-side tooling uses IPv4 to
# avoid resolving `localhost` to an unrelated PostgreSQL listener on ::1.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=geoagent
POSTGRES_PASSWORD=geoagent
POSTGRES_DB=geoagent

# --- Redis ---
# Compose overrides this with the service name `redis` for the API container.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Optional; leave empty for no auth in local dev.
REDIS_PASSWORD=

# --- Redis key TTLs (seconds) ---
REDIS_SESSION_TTL=3600
AGENT_REQUEST_LOCK_TTL=600
REDIS_ECHO_TTL=1800
# How long a minted ref (plc_/src_) stays resolvable.
REDIS_REF_TTL=86400

# --- LLM ---
# LLM_MODE: mock | vllm
#   mock -> returns a hardcoded ReAct trace, no network. Used in CI and by default.
#   vllm -> talks to an OpenAI-compatible vLLM server (see README).
LLM_MODE=mock
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=geoagent-model
# API key for the vLLM OpenAI-compatible endpoint (matches vllm --api-key).
LLM_API_KEY=
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
# Optional OpenRouter reasoning budget: none|minimal|low|medium|high|xhigh|max.
# Leave empty for OpenAI-compatible endpoints that do not support this field.
LLM_REASONING_EFFORT=
# Optional explicit reasoning-token budget. Do not set together with effort.
LLM_REASONING_MAX_TOKENS=
# Outbound proxy for the model endpoint (e.g. http://127.0.0.1:12334).
# Needed for a remote API when direct egress is blocked. Empty for a local server.
LLM_HTTP_PROXY=

# --- Tool providers ---
# Provider lists are JSON arrays. Places search checks 2GIS coverage first, then
# falls back to TomTom and Yandex when the locality is not covered;
# routing uses 2GIS first, then GraphHopper, OSRM, and Yandex as fallbacks.
# GraphHopper has a 2-second attempt budget.
# Web search uses the stable Exa, Tavily, Firecrawl priority and calls the first
# enabled provider only.
# An empty list disables the corresponding tool.
# Recommended production places set: ["twogis","tomtom"]. The coordinator
# enforces this priority even if the configured array has a different order.
PLACES_SEARCH_PROVIDERS=[]
ROUTING_PROVIDERS=[]
# Shared named-place chain for places-search anchors and textual routing points.
# The TomTom geocoder is always the final fallback.
TEXT_PLACE_RESOLUTION_PROVIDERS=["twogis","tomtom"]
WEB_SEARCH_PROVIDERS=[]
# Maximum duration of one external HTTP request and one complete tool call.
TOOLS_HTTP_TIMEOUT=15
TOOLS_EXECUTION_TIMEOUT=45
# 2GIS Places/Regions uses this shorter per-attempt limit before falling back
# to TomTom. It does not change timeout settings for other tool providers.
DGIS_CATALOG_TIMEOUT=3
# Outbound proxy for tool traffic, e.g. http://127.0.0.1:12334. Empty = direct.
# Set explicitly; HTTP_PROXY/ALL_PROXY from the shell are deliberately ignored.
TOOLS_HTTP_PROXY=
# Bare city resolution accepts only the supported geography: Europe, Russia,
# Kazakhstan, Uzbekistan, Kyrgyzstan, Tajikistan, Armenia, Georgia, and
# Azerbaijan. Omit this variable to use that default; to override it, use a
# JSON array, for example: GEOCODING_ALLOWED_COUNTRY_CODES=["RU","KZ","UZ"]

# Used when PLACES_SEARCH_PROVIDERS contains "yandex".
YANDEX_ORGANISATION_SEARCH_API_KEY=

# Used whenever PLACES_SEARCH_PROVIDERS or ROUTING_PROVIDERS is non-empty.
# TomTom Geocoding resolves textual cities, anchors, addresses, and route
# points. The same key also serves TomTom place search and named-POI fallback.
TOMTOM_API_KEY=
TOMTOM_SEARCH_BASE_URL=https://api.tomtom.com/search/2

# Used when PLACES_SEARCH_PROVIDERS or ROUTING_PROVIDERS contains "twogis".
# Enable Places/Regions and Navigation APIs on the same key as needed.
DGIS_API_KEY=
DGIS_CATALOG_BASE_URL=https://catalog.api.2gis.com
DGIS_ROUTING_BASE_URL=https://routing.api.2gis.com

# Used when ROUTING_PROVIDERS contains "yandex". Distance Matrix and Route
# Details require a commercial Yandex Maps API key.
YANDEX_ROUTING_API_KEY=

# Used when ROUTING_PROVIDERS contains "graphhopper".
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
# Warn when a routing provider moves a resolved point this far to reach its graph.
ROUTING_SNAP_WARNING_DISTANCE_M=250

# Used when ROUTING_PROVIDERS contains "osrm". The default public demo server
# requires no key and has no production SLA; point this at your own/hosted OSRM
# deployment for production.
OSRM_BASE_URL=https://router.project-osrm.org
# Separate FOSSGIS OSRM graph built with a worldwide pedestrian profile.
# Public usage is limited to 1 request/second; do not use it for heavy traffic.
OSRM_WALKING_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_USER_AGENT=GeoAgent/0.0.0

# Used when WEB_SEARCH_PROVIDERS contains "tavily".
TAVILY_API_KEY=

# Used when WEB_SEARCH_PROVIDERS contains "exa".
EXA_API_KEY=

# Used when WEB_SEARCH_PROVIDERS contains "firecrawl".
FIRECRAWL_API_KEY=

# --- Scope gate ---
# rule_based (default) = regex, no LLM call. llm = classify with the scoper
# prompt via LLM_MODE's backend; falls back to the regex gate if the model is
# unreachable or answers unparseably. no_scoper = allow every request and log
# the scope provider as no_scoper.
# classifier = fine-tuned e5 encoder first, LLM scoper only inside its grey zone.
SCOPE_PROVIDER=rule_based
# Give the classifier its own endpoint so a one-word verdict does not queue
# behind the main model. Empty = reuse the main LLM backend.
# Measured: 0.5B answers "yes" to everything, 1.5B gets 6/8, 3B gets 8/8 — do not
# go below 3B. See "Deployment" in the README.
SCOPE_BASE_URL=
SCOPE_API_KEY=
# Model name at that endpoint. Empty = LLM_MODEL.
SCOPE_MODEL=

# --- Scope classifier (only read when SCOPE_PROVIDER=classifier) ---
# A vLLM server started with `--runner pooling`; the gate posts to /classify.
# Give the ROOT, not the /v1 path — this is not the OpenAI chat API.
SCOPE_CLASSIFIER_BASE_URL=
SCOPE_CLASSIFIER_API_KEY=
SCOPE_CLASSIFIER_MODEL=
# The three below must match artifacts/scope_bert_meta.json shipped with the
# weights. Changing weights without changing these shifts the verdict silently.
SCOPE_CLASSIFIER_PREFIX="query: "
SCOPE_CLASSIFIER_TEMPERATURE=2.332827091217041
# Scores between these two are handed to the LLM scoper, which sees the dialogue.
# Set both equal to disable the cascade and use a single threshold.
SCOPE_CLASSIFIER_GREY_LOW=0.4
SCOPE_CLASSIFIER_GREY_HIGH=0.6
SCOPE_CLASSIFIER_TIMEOUT=5
# true = after one in-scope verdict, stop classifying this session entirely.
# Needed because the classifier is contextless and would reject "а что рядом?".
# The cost: the session stays ungated until its Redis TTL expires.
SCOPE_SESSION_UNLOCK=true

# --- Scope OOD check: defer unfamiliar requests to the LLM scoper ------------
# The grey zone only catches requests near the threshold. Requests on topics the
# classifier never saw land confidently on one side of it instead: measured on
# production-shaped logs, three of four false positives scored 0.89-0.98 and all
# of them were among the farthest requests from the training corpus.
# off | shadow (measure and log only) | enforce (defer to the LLM scoper).
SCOPE_OOD_MODE=off
# Built from the same checkpoint that serves /classify. A different encoder gives
# plausible, meaningless distances.
SCOPE_OOD_INDEX_PATH=/app/artifacts/scope_ood_index.npz
# That checkpoint served with `--runner pooling --task embed`. Empty reuses
# SCOPE_CLASSIFIER_BASE_URL, which only works if it also exposes /v1/embeddings.
SCOPE_OOD_BASE_URL=
SCOPE_OOD_MODEL=
# Quantile of the training rows' own distances below which a request is deferred.
# Measured cost on 196 labelled requests: 0.01 defers 2.6% and catches 1 of 4
# false positives; 0.05 defers 11.7% and catches 3 of 4.
SCOPE_OOD_QUANTILE=0.01

# --- Censorship gate ---
# rule_based (default) = regex, no model call — the right choice locally and
# whenever the orchestrator runs against a hosted API. model = classify with the
# censor prompt over a plain OpenAI chat completion; falls back to the regex gate
# if the model is unreachable or answers unparseably.
CENSORSHIP_PROVIDER=rule_based
# Own endpoint, same reasoning as SCOPE_BASE_URL. Empty = reuse the main LLM
# backend. Any OpenAI-compatible server works; no model-specific template is used.
CENSORSHIP_BASE_URL=
CENSORSHIP_API_KEY=
# Model name at that endpoint. Empty = LLM_MODEL.
CENSORSHIP_MODEL=

# User context enrichment (browser coordinates win or IP addr)
IP_GEOLOCATION_ENABLED=true
IP_GEOLOCATION_BASE_URL=https://ipwho.is # 1000 requests per day
IP_GEOLOCATION_TIMEOUT=3
USER_CONTEXT_HTTP_PROXY=

# Dev-only fallback for API calls that omit user_context entirely. It resolves
# the backend egress address, so keep it disabled on a remote deployment.
IP_GEOLOCATION_SELF_LOOKUP_ENABLED=false
